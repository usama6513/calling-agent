generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         String         @default("admin") // admin, manager, agent
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  businesses   Business[]     @relation("UserBusinesses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique // SHA-256 hash of the token
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id            String         @id @default(uuid())
  name          String
  type          String         // restaurant, real estate, ecommerce, consulting, generic
  phone         String?
  email         String?
  address       String?
  website       String?
  description   String?
  knowledgeBase Json?          // Business knowledge base (products, services, FAQs)
  rules         Json?          // Business rules and guidelines
  workingHours  Json?          // Working hours configuration
  aiModel       String?        // Overrides global GROQ_MODEL
  temperature   Float?         // Overrides default 0.7
  maxTokens     Int?           // Overrides default 600
  ownerId       String?        // null = pre-built (admin/system), otherwise = creating user
  owner         User?          @relation("UserBusinesses", fields: [ownerId], references: [id], onDelete: SetNull)
  widgetKey     String?        // per-business key for public widget history reads (data-widget-key)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  appointments  Appointment[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String?
  phone     String?  @unique
  email     String?  @unique
  metadata  Json?    // Additional customer data
  createdAt DateTime @default(now())
  conversations Conversation[]
}

model Conversation {
  id         String    @id @default(uuid())
  businessId String
  customerId String?
  channel    String    // phone, whatsapp, web, sms
  status     String    @default("active") // active, closed, transferred
  metadata   Json?     // Call duration, recording URL, etc.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]
  attachments Attachment[]
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // user, assistant, system
  content        String
  tokens         Int?         // Token usage
  metadata       Json?        // Additional message data
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Attachment {
  id             String       @id @default(uuid())
  conversationId String
  filename       String
  mimeType       String
  size           Int
  data           Bytes        // File content
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model SecurityScan {
  id        String   @id @default(uuid())
  status    String   // healthy, warning, critical
  summary   String?  // human readable summary
  checks    Json     // individual check results
  issues    Json     // list of found issues
  duration  Int?     // ms
  createdAt DateTime @default(now())
  @@index([status])
  @@index([createdAt])
}

model SecurityExercise {
  id          String   @id @default(uuid())
  status      String   // secure, vulnerable, inconclusive
  summary     String?  // human readable summary
  score       Int      // defense score 0-100
  attacks     Json     // red team attacks + outcomes
  defenses    Json     // blue team defensive verifications
  triggeredBy String   @default("cron") // cron, manual
  duration    Int?     // ms
  createdAt   DateTime @default(now())
  @@index([status])
  @@index([createdAt])
}

model BankAccount {
  id            String          @id @default(uuid())
  accountNumber String          @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  accountType   String          @default("savings") // savings, current, business
  balance       Float           @default(0)
  currency      String          @default("PKR")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  transactions  BankTransaction[]
}

model BankTransaction {
  id             String       @id @default(uuid())
  accountId      String
  type           String       // deposit, withdraw, transfer_in, transfer_out, fee
  amount         Float
  balanceAfter   Float
  description    String?
  reference      String?      // reference/IBAN for transfers
  status         String       @default("completed") // pending, completed, failed
  createdAt      DateTime     @default(now())
  account        BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId])
  @@index([createdAt])
}

model Appointment {
  id          String   @id @default(uuid())
  businessId  String
  customerName String
  customerPhone String
  customerEmail String?
  date        DateTime
  time        String
  service     String
  notes       String?
  status      String   @default("pending") // pending, confirmed, cancelled, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
